{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/remix"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "!!**/out",
      "!!**/.next",
      "!!**/node_modules",
      "!!**/graphql",
      "!!**/*.graphql",
      "!!**/*.svg"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off"
      },
      "style": {
        "useConsistentTypeDefinitions": "off",
        "noNonNullAssertion": "off",
        "useFragmentSyntax": "off",
        "noMagicNumbers": "off",
        "useBlockStatements": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noConsole": "off",
        "noLeakedRender": "off",
        "noUnnecessaryConditions": "off",
        "noShadow": "off"
      },
      "performance": {
        "noNamespaceImport": "off",
        "noJsxPropsBind": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // react-three-fiber JSX elements are three.js objects, not DOM elements
      "includes": ["src/components/avatar/**", "src/components/three/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ]
}
