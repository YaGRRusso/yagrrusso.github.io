{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/next", "ultracite/react"],
  "files": {
    "includes": [
      "**",
      "!!**/out",
      "!!**/.next",
      "!!**/node_modules",
      "!!**/graphql"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useConsistentTypeDefinitions": "off",
        "noNonNullAssertion": "off",
        "useFragmentSyntax": "off",
        "noMagicNumbers": "off",
        "useBlockStatements": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noConsole": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "nursery": {
        "noLeakedRender": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
